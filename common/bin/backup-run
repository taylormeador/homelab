#!/bin/bash
# usage: backup-run <job> -- <command...>
job=$1; shift; [ "$1" = "--" ] && shift
d=/var/lib/prometheus/node-exporter
"$@"; rc=$?
now=$(date +%s)
printf 'backup_last_exit_code{job="%s"} %s\nbackup_last_run_timestamp_seconds{job="%s"} %s\n' "$job" "$rc" "$job" "$now" > "$d/.$job.status"
chmod 644 "$d/.$job.status"; mv "$d/.$job.status" "$d/backup_${job}_status.prom"
if [ "$rc" -eq 0 ]; then
  printf 'backup_last_success_timestamp_seconds{job="%s"} %s\n' "$job" "$now" > "$d/.$job.ok"
  chmod 644 "$d/.$job.ok"; mv "$d/.$job.ok" "$d/backup_${job}_success.prom"
fi
exit "$rc"
