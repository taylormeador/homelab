#!/bin/bash
set -euo pipefail
NAME=$1
export RESTIC_REPOSITORY=/mnt/srv1-storage/minecraft
export RESTIC_PASSWORD_FILE=/root/.restic-pass

systemctl stop "$NAME"
trap 'systemctl start "$NAME"' EXIT

restic backup --exclude "/home/minecraft/minecraftbe/$NAME/logs" "/home/minecraft/minecraftbe/$NAME"
restic forget --keep-daily 7 --keep-weekly 8 --keep-monthly 12 --prune
